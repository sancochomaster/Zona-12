# Copia este archivo con el nombre .env y llena tus propios datos.

# Cadena de conexión a MongoDB (Atlas o local), incluyendo el nombre de la base de datos
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/zona12

# Puerto donde corre el servidor Express
PORT=4000

# Dominio(s) del frontend publicados que pueden usar la API (separados por coma).
# En local no hace falta; en producción pon la URL de tu web en Vercel.
# Ejemplo: FRONTEND_URL=https://zona12.vercel.app
FRONTEND_URL=
